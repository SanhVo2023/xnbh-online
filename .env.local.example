# ── Mắt Việt — Xác Nhận Bảo Hành ─────────────────────────────────────────────
# Copy this file to `.env.local` for local dev, and set the same vars in Netlify.

# The deployed Google Apps Script Web App URL (ends with /exec).
# Leave EMPTY to run the app in MOCK MODE (no real backend; vouchers faked locally).
GAS_WEBAPP_URL=

# Shared secret sent as a header to the GAS web app (must match SHARED_SECRET in
# the GAS Script Properties). Prevents random people from POSTing to your GAS URL.
GAS_SHARED_SECRET=

# Where the "DÙNG MÃ NGAY" button sends users (online shop).
NEXT_PUBLIC_SHOP_URL=https://matviet.vn

# Public site URL (used for OG/canonical metadata).
NEXT_PUBLIC_SITE_URL=https://baohanh.matviet.vn
